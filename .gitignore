# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 项目运行时数据（每台机器不同，不入库）----
data/
build/
dist/
*.log

# ---- 依赖（212 MB，用 scripts/bootstrap.py 重建）----
vendor/

# ---- 测试语料（100 MB+，用 spike/gen_corpus.py 重新生成）----
spike/corpus/

# ---- 用户的参考书籍（有版权，绝不入库）----
参考文本/

# ---- EPUB 转换出来的纯文本缓存（可由原书重新生成）----
*_cache/

# ---- 本机生成的快捷方式（绝对路径，用 scripts/make_shortcut.ps1 重建）----
*.lnk

# ---- 运行时生成的诊断文件（排障产物，不入库）----
托盘诊断.txt
tray_diag.txt
*_cache

